# Environment Configuration for Bison Algorithmic Trading Platform

# Application Mode
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security & JWT
SECRET_KEY=super-secret-development-key-change-in-production-1234567890
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL)
POSTGRES_USER=bison_user
POSTGRES_PASSWORD=bison_password
POSTGRES_DB=bison_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://bison_user:bison_password@db:5432/bison_db

# Redis Queue Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Next.js Web Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
