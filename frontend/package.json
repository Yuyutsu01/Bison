    "test:coverage": "vitest run --coverage",
    "dead-code": "ts-prune -e"
  },
  "dependencies": {
    "@xyflow/react": "^12.0.0",
    "clsx": "^2.1.0",
    "lucide-react": "^0.330.0",
    "next": "^14.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^2.12.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.1",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^1.3.1",
    "eslint": "^8.56.0",
    "eslint-config-next": "^16.3.2",
    "eslint-plugin-unused-imports": "^3.0.0",
    "jsdom": "^24.0.0",
    "prettier": "^3.2.5",
    "ts-prune": "^0.10.3",
    "typescript": "^5.3.0",
    "vitest": "^1.3.1"
  }
